      "password_env": null,
      "path": "/Streaming/Channels/101"
    },
    {
      "name": "backyard",
      "enabled": true,
      "host": "192.168.1.51",
      "port": 554,
      "username": "admin",
      "password": null,
      "password_env": "CAM_BACKYARD_PASSWORD",
      "path": "/Streaming/Channels/101"
    },
    {
      "name": "puerta_verde",
      "enabled": true,
      "host": "192.168.1.52",
      "port": 554,
      "username": "admin",
      "password": null,
      "password_env": "CAM_PUERTA_VERDE_PASSWORD",
      "path": "/stream1",
      "stream_path": "/stream2",
